{
  "MaxCount": 4000,
  "Drawable": {
    "Type": "SkCircleDrawable",
    "Radius": 2
  },
  "Code": [
    "void effectSpawn(inout Effect effect) {",
    "  effect.lifetime = 4;",
    "}",
    "",
    "void effectUpdate(inout Effect effect) {",
    "  effect.color.r = 0;",
    "  effect.color.g = 1.0 - effect.age;",
    "  effect.color.b = effect.age;",
    "  effect.rate = effect.age < 0.75 ? 800 : 0;",
    "}",
    "",
    "void spawn(inout Particle p) {",
    "  p.lifetime = 4;",
    "  p.pos = uniforms.mouse_pos;",
    "  p.frame = effect.age / 0.75 + mix(-0.05, 0.05, rand(p.seed));",
    "}",
    "",
    "void update(inout Particle p) {",
    "  // Пример: движение к цели с плавным интерполированием",
    "  p.pos = mix(p.pos, uniforms.textPos.xy, 0.05);",
    "}"
  ],
  "Uniforms": [
    {
      "Name": "mouse_pos",
      "Type": "float2",
      "Default": [0.0, 0.0]
    },
    {
      "Name": "textPos",
      "Type": "float2",
      "Default": [0.0, 0.0]
    }
  ],
  "Bindings": [
    {
      "Type": "SkTextBinding",
      "Name": "text",
      "Text": "FMXBridgeSk",
      "FontSize": 96,
      "PosUniform": "textPos"
    }
  ]
}