uniform float2 iResolution;
uniform float iTime;
uniform float iTimeDelta;

uniform float uProgress;
uniform float2 uCenter;
uniform float3 uAccent;
uniform float4 uTint;

// Integer uniforms: scalar mode, grid dimensions, feature flags and RGB palette + intensity.
uniform int uMode;
uniform int2 uGrid;
uniform int3 uFlags;
uniform int4 uPalette;

half4 main(float2 fragCoord)
{
    float2 resolution = max(iResolution, float2(1.0, 1.0));
    float2 uv = fragCoord / resolution;

    // Aspect-corrected coordinates around a center controlled by float2.
    float2 p = (uv - uCenter) * float2(resolution.x / resolution.y, 1.0);
    float radius = length(p);
    float edge = abs(radius - 0.30);

    float ring = 1.0 - smoothstep(0.006, 0.018, edge);
    float halo = exp(-edge * 24.0);

    float angle = fract((atan(p.y, p.x) + 3.14159265) / 6.28318530);
    float progressMask = 1.0 - step(uProgress, angle);
    float marker = 1.0 - smoothstep(0.004, 0.016, abs(angle - uProgress));

    float pulse = 0.65 + 0.35 * sin(iTime * 2.4);
    float sweep = 0.5 + 0.5 * sin(iTime * 0.7);

    float3 backgroundA = float3(0.018, 0.025, 0.050);
    float3 backgroundB = float3(0.075, 0.035, 0.105);
    float3 rgb = mix(backgroundA, backgroundB, uv.x * 0.82 + uv.y * 0.18);

    // int4 -> palette color plus intensity (all channels use the 0..255 range).
    float3 paletteColor = clamp(
        float3(float(uPalette.x), float(uPalette.y), float(uPalette.z)) / 255.0,
        0.0, 1.0);
    float paletteIntensity = clamp(float(uPalette.w) / 255.0, 0.0, 1.0);

    // int2 controls the number of grid cells in each direction.
    float gridX = float(uGrid.x > 0 ? uGrid.x : 1);
    float gridY = float(uGrid.y > 0 ? uGrid.y : 1);
    float2 gridUV = uv * float2(gridX, gridY);
    float2 gridFrac = fract(gridUV);
    float2 gridEdge = min(gridFrac, 1.0 - gridFrac);
    float gridLine = 1.0 - smoothstep(0.0, 0.012, min(gridEdge.x, gridEdge.y));
    rgb += paletteColor * gridLine * paletteIntensity * 0.10;

    // int3 flags independently enable the wave, progress ring and moving marker.
    if (uFlags.x != 0)
    {
        float waveY = 0.52 + 0.055 * sin(uv.x * 15.0 - iTime * 1.1)
                           + 0.018 * sin(uv.x * 31.0 + iTime * 0.6);
        float wave = 1.0 - smoothstep(0.002, 0.010, abs(uv.y - waveY));
        rgb += uAccent * wave * (0.18 + 0.10 * sweep) * (1.0 - smoothstep(0.48, 0.72, uv.x));
    }

    // The bottom line visualizes the frame delta supplied by the animation clock.
    float deltaBand = 1.0 - smoothstep(0.0, 0.008, abs(uv.y - 0.95));
    float deltaLevel = clamp(iTimeDelta * 60.0, 0.0, 1.0);
    rgb += uAccent * deltaBand * deltaLevel * 0.18;

    if (uFlags.y != 0)
    {
        float ringLevel = 0.12 + 0.88 * progressMask;
        float3 arcColor;
        if (uMode == 0)
            arcColor = mix(uAccent, uTint.rgb, pulse * 0.58);
        else if (uMode == 1)
            arcColor = mix(uAccent, paletteColor, pulse * 0.58);
        else if (uMode == 2)
            arcColor = mix(paletteColor, uTint.rgb, pulse * 0.58);
        else
            arcColor = paletteColor;

        rgb += arcColor * ring * ringLevel;
        rgb += paletteColor * halo * paletteIntensity * (0.025 + 0.10 * progressMask);
        rgb += uTint.rgb * marker * pulse * 0.75;
    }

    if (uFlags.z != 0)
    {
        float markerAngle = fract(sweep);
        float markerGlow = (1.0 - smoothstep(0.005, 0.020, abs(angle - markerAngle)))
                         * (1.0 - smoothstep(0.012, 0.040, abs(radius - 0.30)));
        rgb += uTint.rgb * markerGlow * 0.8;
    }

    return half4(rgb, 1.0);
}
